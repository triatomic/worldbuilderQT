<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>WBQtMapGenDialog</class>
 <widget class="QDialog" name="WBQtMapGenDialog">
  <property name="windowTitle">
   <string>Generate Map</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <widget class="QGroupBox" name="seedBox">
     <property name="title">
      <string>Seed</string>
     </property>
     <layout class="QHBoxLayout" name="seedLayout">
      <item>
       <widget class="QSpinBox" name="seed">
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>999999999</number>
        </property>
        <property name="toolTip">
         <string>The same seed and settings always produce the same map.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="randomize">
        <property name="text">
         <string>Randomize</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="layoutBox">
     <property name="title">
      <string>Layout</string>
     </property>
     <layout class="QGridLayout" name="layoutGrid">
      <item row="0" column="0">
       <widget class="QLabel" name="playersLabel">
        <property name="text">
         <string>Players:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="players">
        <property name="toolTip">
         <string>Start positions are spaced evenly around the centre of the map.</string>
        </property>
        <item>
         <property name="text">
          <string>2</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>4</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>6</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>8</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="baseHeightLabel">
        <property name="text">
         <string>Base height:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="baseHeight">
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>200</number>
        </property>
        <property name="toolTip">
         <string>The height the whole map starts at, before the terrain layers are added.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="featuresBox">
     <property name="title">
      <string>Features</string>
     </property>
     <layout class="QGridLayout" name="featuresGrid">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="doCliffs">
        <property name="text">
         <string>Generate cliffs</string>
        </property>
        <property name="toolTip">
         <string>Cut back over-steep slopes and mark them impassable.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="cliffDensityLabel">
        <property name="text">
         <string>Cliff amount:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="cliffDensity">
        <item>
         <property name="text">
          <string>Low</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Medium</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>High</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="doTextures">
        <property name="text">
         <string>Paint terrain textures</string>
        </property>
        <property name="toolTip">
         <string>Texture cliffs and open ground differently, using the textures this map already has loaded.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="doTrees">
        <property name="text">
         <string>Scatter trees</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="treeDensityLabel">
        <property name="text">
         <string>Tree amount:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QComboBox" name="treeDensity">
        <item>
         <property name="text">
          <string>Low</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Medium</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>High</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="5" column="0" colspan="2">
       <widget class="QCheckBox" name="doRocks">
        <property name="text">
         <string>Scatter rocks</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QCheckBox" name="doPlayers">
        <property name="text">
         <string>Add skirmish players</string>
        </property>
        <property name="toolTip">
         <string>Add the standard skirmish sides. Without them the map has start positions but no players, and will not show up as a skirmish map.</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0" colspan="2">
       <widget class="QCheckBox" name="doSupplies">
        <property name="text">
         <string>Place supply sources</string>
        </property>
        <property name="toolTip">
         <string>Put a pair of supply docks near each start, the same for every player.</string>
        </property>
       </widget>
      </item>
      <item row="8" column="0">
       <widget class="QLabel" name="roadModeLabel">
        <property name="text">
         <string>Roads:</string>
        </property>
       </widget>
      </item>
      <item row="8" column="1">
       <widget class="QComboBox" name="roadMode">
        <property name="toolTip">
         <string>Roads are run between the player start positions. Via supplies routes them past each side's supply points as well.</string>
        </property>
        <item>
         <property name="text">
          <string>None</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Between starts</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Between starts, via supplies</string>
         </property>
        </item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="noteLabel">
     <property name="text">
      <string>Generates into the current map, at its existing size. One Undo reverses it.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>0</width>
       <height>8</height>
      </size>
     </property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonRow">
     <item>
      <spacer name="buttonSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>0</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="ok">
       <property name="text">
        <string>Generate</string>
       </property>
       <property name="default">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="cancel">
       <property name="text">
        <string>Cancel</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
