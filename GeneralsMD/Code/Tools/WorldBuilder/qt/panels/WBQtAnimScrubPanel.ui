          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
         <item>
         <widget class="QLabel" name="frameText">
          <property name="toolTip">
           <string>Frame within the longest animation on this object.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
