<ui version="4.0">
 <class>WBQtAnimScrubPanel</class>
 <widget class="QWidget" name="WBQtAnimScrubPanel">
  <property name="windowTitle">
   <string>Animation Scrubber</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <layout class="QGridLayout" name="infoGrid" columnstretch="0,1">
     <item row="0" column="0">
      <widget class="QLabel" name="objectLabel">
       <property name="text">
        <string>Object:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLabel" name="objectText">
       <property name="text">
        <string>(nothing selected)</string>
