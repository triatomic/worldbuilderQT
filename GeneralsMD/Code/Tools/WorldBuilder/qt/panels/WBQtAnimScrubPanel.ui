      <widget class="QLabel" name="modulesText"/>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="scrubBox">
     <property name="title">
      <string>Position</string>
     </property>
     <layout class="QVBoxLayout" name="scrubLay">
      <item>
       <widget class="QSlider" name="scrub">
        <property name="toolTip">
         <string>Scrub the selected object's animations. One step is one frame of the longest animation; every draw module maps that position onto its own frame count, so modules of different lengths stay in step.</string>
        </property>
        <property name="maximum">
         <number>0</number>
        </property>
        <property name="singleStep">
         <number>1</number>
        </property>
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="frameText">
        <property name="toolTip">
         <string>Frame within the longest animation on this object.</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonRow">
     <item>
      <widget class="QPushButton" name="startBtn">
       <property name="text">
        <string>Start</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="endBtn">
       <property name="text">
        <string>End</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="buttonSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="restBtn">
       <property name="toolTip">
        <string>Stop scrubbing and let the object return to the pose the view normally shows.</string>
       </property>
       <property name="text">
        <string>Release</string>
       </property>
